# =============================================================================
# DIETER PRO - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="DIETER PRO"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://dieter:dieter_secret@localhost:5432/dieter_pro_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dieter_pro_db
DB_USER=dieter
DB_PASSWORD=dieter_secret
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# -----------------------------------------------------------------------------
# Redis (Cache + Queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# NextAuth (Frontend Auth)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your-nextauth-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe (Payments)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_id
STRIPE_PRICE_STUDIO_MONTHLY=price_your_studio_monthly_id
STRIPE_PRICE_STUDIO_YEARLY=price_your_studio_yearly_id

# -----------------------------------------------------------------------------
# AWS S3 (Audio Storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=dieter-pro-audio
AWS_S3_BUCKET_PUBLIC=dieter-pro-public
AWS_CLOUDFRONT_URL=https://cdn.yourdomain.com

# -----------------------------------------------------------------------------
# AI / Music Generation APIs
# -----------------------------------------------------------------------------
# Suno AI
SUNO_API_KEY=your_suno_api_key
SUNO_API_URL=https://api.suno.ai

# OpenAI (for lyrics, descriptions)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Loudly API
LOUDLY_API_KEY=your_loudly_api_key
LOUDLY_API_URL=https://api.loudly.com

# Udio API
UDIO_API_KEY=your_udio_api_key

# -----------------------------------------------------------------------------
# Python DSP Worker
# -----------------------------------------------------------------------------
DSP_WORKER_URL=http://localhost:8000
DSP_WORKER_API_KEY=your_dsp_worker_api_key

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="DIETER PRO <noreply@dieterpro.com>"

# -----------------------------------------------------------------------------
# BullMQ Job Queue Config
# -----------------------------------------------------------------------------
BULLMQ_CONCURRENCY=5
BULLMQ_MAX_RETRIES=3
BULLMQ_RETRY_DELAY=5000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
POSTHOG_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AI_GENERATION=true
FEATURE_COLLABORATION=false
FEATURE_MARKETPLACE=false
